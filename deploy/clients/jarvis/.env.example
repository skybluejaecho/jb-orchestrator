JB_JARVIS_IMAGE=jb-orchestrator-jarvis:0.1.0-dev
JB_JARVIS_PORT=3300

# Remote Control Plane reachable from this client host over VPN or HTTPS.
# For a tunnel on the Docker host, use http://host.docker.internal:<forwarded-port>.
JARVIS_CONTROL_PLANE_URL=https://control.example.com

# Issue a distinct, least-privilege service account token for this client installation.
JARVIS_API_TOKEN=replace-with-this-client-service-account-token
