# Local builds use this development tag. For deployment, pin the released GHCR image as documented.
JB_RUNTIME_IMAGE=jb-orchestrator-runtime:0.1.0-dev
JB_POSTGRES_PASSWORD=replace-with-a-long-random-password
JB_API_BIND_ADDRESS=127.0.0.1
JB_API_PORT=8000
JB_LOG_LEVEL=INFO

# Host directories mounted into the task and SCM workers.
JB_REPOSITORY_ROOT=./runtime/repositories
JB_WORKTREE_ROOT=./runtime/worktrees
JB_SKILL_ROOT=../../skills
JB_SKILL_ALLOWED_REMOTE_HOSTS=[]

# OpenClaw Gateway; leave bootstrap values empty after a device token is persisted.
OPENCLAW_GATEWAY_URL=ws://host.docker.internal:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PASSWORD=
OPENCLAW_GATEWAY_TLS_FINGERPRINT=

# GitHub SCM publisher.
JB_GITHUB_TOKEN=
JB_GITHUB_API_URL=https://api.github.com
JB_GITHUB_WEB_HOST=github.com
JB_SCM_AUTOMATIC_RETRY_LIMIT=0

# Signed Webhook notification provider. Keep this compact JSON on one line.
JB_WEBHOOK_DESTINATIONS={}
JB_NOTIFICATION_AUTOMATIC_RETRY_LIMIT=0

# Used only by one-shot admin containers and MCP host configuration.
JB_CONTROL_PLANE_URL=http://api:8000
JB_API_TOKEN=
