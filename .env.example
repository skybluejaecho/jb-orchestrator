JB_ENVIRONMENT=local
JB_LOG_LEVEL=INFO
JB_API_HOST=127.0.0.1
JB_API_PORT=8000
JB_API_AUTH_ENABLED=false
# JB_API_TOKEN=<service-account-token-for-cli>
JB_SSE_POLL_INTERVAL_SECONDS=1
JB_SSE_HEARTBEAT_INTERVAL_SECONDS=15
JB_CONTROL_PLANE_URL=http://127.0.0.1:8000
JB_DATABASE_URL=postgresql+asyncpg://jb_orchestrator:jb_orchestrator@localhost:5432/jb_orchestrator
JB_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
JB_WORKER_CANCELLATION_TIMEOUT_SECONDS=10
JB_SKILL_CACHE_DIR=.jb-orchestrator/cache/skills
JB_SKILL_LOCAL_ROOT=skills
JB_SKILL_ALLOWED_REMOTE_HOSTS=[]
JB_OPENCLAW_BRIDGE_PATH=tools/openclaw-gateway-spike/src/bridge.mjs
JB_OPENCLAW_NODE_EXECUTABLE=node
JB_OPENCLAW_DEVICE_STATE_DIR=.jb-orchestrator/openclaw-device
# Required only for task nodes using workspace_mode=git_worktree.
# JB_OPENCLAW_WORKSPACE_ROOT=C:\worktrees\jb-orchestrator
# JB_OPENCLAW_REPOSITORY_ROOTS=["C:\\projects"]
JB_OPENCLAW_GIT_EXECUTABLE=git
# Required only when adapters/github is installed for SCM publication.
# JB_GITHUB_TOKEN=<fine-grained-token-with-pull-requests-write>
# JB_GITHUB_WORKSPACE_ROOTS=["C:\\worktrees\\jb-orchestrator"]
# JB_GITHUB_API_URL=https://api.github.com
# JB_GITHUB_WEB_HOST=github.com
# JB_GITHUB_API_VERSION=2026-03-10
# JB_GITHUB_GIT_EXECUTABLE=git
# JB_GITHUB_REMOTE_NAME=origin
# Test-only: accepted solely for loopback HTTP when JB_ENVIRONMENT=test.
# JB_GITHUB_ALLOW_INSECURE_LOOPBACK=false
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=<set-in-process-environment>
# OPENCLAW_GATEWAY_TLS_FINGERPRINT=<sha256-fingerprint-for-wss>
